<!DOCTYPE html>
<html>
<head>
  <title>Orbixa Store</title>

  <style>
    body {
      font-family: Arial;
      padding: 20px;
      background: #f5f5f5;
    }

    .products {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .card {
      background: white;
      border-radius: 10px;
      padding: 15px;
      width: 160px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    button {
      margin-top: 10px;
      padding: 8px;
      background: black;
      color: white;
      border: none;
      border-radius: 5px;
    }
  </style>
</head>

<body>

<h1>🛍️ Orbixa</h1>
<p>Your world of smart shopping</p>
<hr>

<div class="products">
  <div class="card">
    <h3>T-Shirt</h3>
    <p>$20</p>
    <button onclick="addToCart('T-Shirt', 20)">Add</button>
  </div>

  <div class="card">
    <h3>Shoes</h3>
    <p>$50</p>
    <button onclick="addToCart('Shoes', 50)">Add</button>
  </div>

  <div class="card">
    <h3>Cap</h3>
    <p>$15</p>
    <button onclick="addToCart('Cap', 15)">Add</button>
  </div>
</div>

<h2>Cart</h2>
<ul id="cart"></ul>

<h3 id="total">Total: $0</h3>

<button onclick="buyNow()">Buy Now</button>

<script>
let cart = [];

function addToCart(name, price) {
  cart.push({ name, price });
  showCart();
}

function showCart() {
  let cartList = document.getElementById("cart");
  let total = 0;
  cartList.innerHTML = "";

  cart.forEach(item => {
    let li = document.createElement("li");
    li.textContent = item.name + " - $" + item.price;
    cartList.appendChild(li);
    total += item.price;
  });

  document.getElementById("total").textContent = "Total: $" + total;
}

function buyNow() {
  alert("Order placed! Payment coming soon.");
}
</script>

</body>
</html>
